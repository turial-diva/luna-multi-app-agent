.DS_Store

# Luna Agent secrets / local auth
app/LunaAgent/.env
app/LunaAgent/.google-token.json

# Luna Agent dependencies / build output
app/LunaAgent/node_modules/
app/LunaAgent/dist/

# Luna Agent local backups / editor files
app/LunaAgent/*.backup
app/LunaAgent/*.backup-*
app/LunaAgent/*.before-*
app/LunaAgent/tools/*.before-*
app/LunaAgent/**/*.swp

# Lambda generated/dependency files
luna-api-lambda/node_modules/
luna-api-lambda/*.zip
luna-api-lambda/response.json
luna-api-lambda/index.mjs.backup-*

# AgentCore generated deployment state
agentcore/.cli/deployed-state.json
agentcore/aws-targets.json

# Logs
*.log

# AgentCore CLI local state
agentcore/.cli/
